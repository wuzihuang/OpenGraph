#!/bin/sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if [ ! -d "$plugin_root/node_modules/better-sqlite3" ]; then
  npm install --prefix "$plugin_root" --omit=dev --no-audit --no-fund >&2
fi

GRAPH_PLUGIN_ROOT=$plugin_root
export GRAPH_PLUGIN_ROOT
exec node "$plugin_root/runtime/server.mjs"
